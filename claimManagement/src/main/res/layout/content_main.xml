<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="org.openimis.imisclaims.MainActivity"
    tools:showIn="@layout/app_bar_main"
    android:orientation="vertical"
    android:background="@color/offWhite"
    android:padding="16dp">

    <!-- Dashboard Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif-medium"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary" />

    <!-- Stats Cards Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <!-- Accepted Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_stat_card"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/pink"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_accepted"
                android:padding="12dp"
                android:background="@drawable/bg_icon_circle_green"
                android:contentDescription="@string/accepted" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/accepted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/accepted"
                    android:fontFamily="sans-serif"
                    android:textSize="16sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/accepted_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/Green" />

            </LinearLayout>

        </LinearLayout>

        <!-- Rejected Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_stat_card"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/rejected_icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_rejected"
                android:padding="12dp"
                android:background="@drawable/bg_icon_circle_red"
                android:contentDescription="@string/rejected" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/rejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rejected"
                    android:fontFamily="sans-serif"
                    android:textSize="16sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/rejected_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/Red" />

            </LinearLayout>

        </LinearLayout>

        <!-- Pending Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_stat_card"
            android:padding="20dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/pending_icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_pending"
                android:padding="12dp"
                android:background="@drawable/bg_icon_circle_orange"
                android:contentDescription="@string/pending" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/pending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pending"
                    android:fontFamily="sans-serif"
                    android:textSize="16sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/entered_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/Orange" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
